# Copy this file to .dev.vars for local development (.dev.vars is git-ignored).
# Never put real keys in this example file — it is committed to Git.
DEV_AUTH_BYPASS=true
# Local only: the placeholder AUD is what allows the sign-in bypass during development.
ACCESS_AUD=set-me
MAILGUN_API_KEY=your-mailgun-sending-key
MAILGUN_WEBHOOK_SIGNING_KEY=your-mailgun-webhook-signing-key
UNSUB_SECRET=any-long-random-string
